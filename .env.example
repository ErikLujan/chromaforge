# Public client-side Supabase configuration (safe to expose to the browser).
# Only VITE_-prefixed variables are inlined into the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The following credentials MUST stay server-side and MUST NEVER use the VITE_
# prefix. They are listed here only to document that they must NOT be exposed:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN=
